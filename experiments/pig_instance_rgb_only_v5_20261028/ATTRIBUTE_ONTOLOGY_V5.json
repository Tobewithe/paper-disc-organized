    {"id":"support_and_pose","sources":["T09","T10","T11","T12"],"fields":[
      {"key":"coarse_posture","type":"enum","values":["standing","sitting","sternal_lying","lateral_lying","lying_unspecified","supine_candidate","other"],"definition":"derived from cited support/anatomy evidence; no forced subclass under occlusion"},
      {"key":"supporting_body_region","type":"set","values":["feet","ventral_torso","lateral_torso","hindquarters","other_visible_region"],"definition":"candidate observed/inferred support distinguished"},
      {"key":"torso_elevation","type":"enum","values":["visibly_elevated","appears_ground_supported","indeterminate"],"definition":"qualitative only; overhead images may not identify height"},
      {"key":"visible_limb_support","type":"object","definition":"per visible_limb_id support evidence and ownership, no guessed hidden feet"},
      {"key":"limb_flexion","type":"object","definition":"per visible limb extended/flexed/indeterminate with image evidence"},
      {"key":"body_roll_evidence","type":"object","definition":"dorsal/ventral/side support cues; not metric 3D roll"},
      {"key":"spine_curvature","type":"enum","values":["apparently_straight","apparently_curved","indeterminate"],"definition":"apparent image shape, not vertebral reconstruction"},
      {"key":"head_elevation","type":"enum","values":["apparently_raised","apparently_lowered","indeterminate"],"definition":"relative visual cue with reference surface"},
      {"key":"ear_configuration","type":"object","definition":"per visible ear geometry/visibility; no forced bilateral state"},
      {"key":"tail_configuration","type":"enum","values":["curled_visible","straight_visible","other_visible_configuration","indeterminate"],"definition":"visible tail only; absence is not amputation"},
      {"key":"mouth_state","type":"enum","values":["apparently_open","apparently_closed","indeterminate"],"definition":"only when mouth evidence is sufficiently visible"}
    ]},
    {"id":"orientation","sources":["T02","T09","T11","T12"],"fields":[
