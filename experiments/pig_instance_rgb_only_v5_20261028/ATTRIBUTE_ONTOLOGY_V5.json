      {"key":"head_tail_axis_endpoints","type":"points","unit":"original_RGB_pixel_edges","definition":"visible or inferred head and tail-root endpoints separately tagged"},
      {"key":"axis_angle_image","type":"number","unit":"degree_clockwise_from_image_positive_x","definition":"computed only with valid endpoints; not world yaw"},
      {"key":"body_surface_view","type":"set","values":["dorsal","ventral","lateral","front","rear","oblique"],"definition":"visible anatomical surface candidates"},
      {"key":"anatomical_side_visible","type":"enum","values":["left_supported","right_supported","both_supported","indeterminate"],"definition":"anatomical side cannot be copied from image left/right"}
    ]},
    {"id":"projected_shape","sources":["T02","T09","T10"],"fields":[
      {"key":"box_width_height","type":"vector","unit":"original_RGB_pixels","definition":"derived from candidate box with location uncertainty retained"},
      {"key":"box_aspect_ratio","type":"number","unit":"ratio","definition":"visible box shape, not unoccluded body proportion"},
      {"key":"normalized_center","type":"vector","unit":"fraction_of_RGB_width_height","definition":"candidate box center, not object physical center of mass"},
      {"key":"projected_size_relative_to_frame","type":"number","unit":"sqrt_box_area_over_RGB_area","definition":"projected scale, not age/weight"},
      {"key":"apparent_trunk_span","type":"object","unit":"original_RGB_pixels","definition":"only supported visible endpoints; occluded span not completed"},
      {"key":"relative_size_same_image","type":"object","definition":"relative projection sizes with target IDs; perspective confound retained"},
      {"key":"mask_area_pixels","type":"number","unit":"RGB_pixels","definition":"unknown unless referenced mask and validity domain exist"},
      {"key":"outline_candidate","type":"regions","definition":"sparse boundary candidate, uncertainty and holes retained"}
    ]},
    {"id":"surface_and_marks","sources":["T09","T12","T14"],"fields":[
      {"key":"apparent_skin_color","type":"enum","values":["light","dark","mottled","other"],"definition":"image-domain appearance; no reflectance or breed inference"},
      {"key":"patch_pattern","type":"regions","definition":"visible patch locations and uncertainty between pigment/dirt/shadow"},
      {"key":"apparent_soiling","type":"object","definition":"visible candidate dirt with region evidence"},
      {"key":"apparent_wetness","type":"object","definition":"reflection/appearance candidate, not physical moisture measurement"},
      {"key":"specular_highlights","type":"regions","definition":"local bright reflections separated from material identity"},
      {"key":"visible_bristles","type":"object","definition":"presence/appearance only where source pixels resolve them"},
      {"key":"visible_ear_tag","type":"object","definition":"image-visible object candidate and owning ear/animal uncertainty"},
