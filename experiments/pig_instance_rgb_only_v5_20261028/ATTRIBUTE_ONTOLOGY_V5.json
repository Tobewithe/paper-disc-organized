  "instance_statuses": ["accepted_candidate", "provisional", "identity_ambiguous", "alias", "rejected_with_evidence"],
  "attribute_groups": [
    {"id":"localization","sources":["T02","T03","T08","T16"],"fields":[
      {"key":"visible_extent_box","type":"box","unit":"original_RGB_pixel_edges","definition":"tight visible-evidence extent candidate; not complete hidden body"},
      {"key":"visible_anchor_points","type":"points","unit":"original_RGB_pixel_edges","definition":"points tied to visible pig evidence with part and view references"},
      {"key":"image_border_truncation","type":"set","values":["left","right","top","bottom","none_observed"],"definition":"actual visible continuation at frame edge; box touching alone insufficient"},
      {"key":"visible_fragment_regions","type":"regions","definition":"candidate disconnected evidence regions and ownership status; not exact mask"},
      {"key":"whole_body_visible_in_frame","type":"enum","values":["supported","not_supported","ambiguous"],"definition":"visible completeness, not amodal extent"},
      {"key":"pixel_mask_candidate","type":"mask_reference","definition":"optional candidate mask with method and lineage; box is never a mask"},
      {"key":"mask_quality_status","type":"enum","values":["not_produced","candidate_unverified","independently_reviewed_at_scope","unusable"],"definition":"unverified polygon or image-processing output cannot silently become pixel GT"}
