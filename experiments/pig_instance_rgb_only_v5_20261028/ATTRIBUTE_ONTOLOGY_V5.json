    ]},
    {"id":"occlusion_and_visibility","sources":["T08","T09","T10","T16"],"fields":[
      {"key":"occluder_types","type":"set","values":["pig","barrier","wall","feeder","other_facility","other_object","none_observed"],"definition":"visible occlusion evidence; none_observed is not absolute absence"},
      {"key":"occluder_entity_refs","type":"references","definition":"current-image entity IDs or unresolved entity nodes"},
      {"key":"occluded_part_refs","type":"references","definition":"parts whose visibility is affected, without hidden-position hallucination"},
      {"key":"occlusion_boundary_regions","type":"regions","definition":"where local front/back ordering is supported"},
      {"key":"fragment_ownership_ambiguity","type":"object","definition":"competing owner IDs for disconnected evidence"},
      {"key":"visibility_qualitative","type":"enum","values":["mostly_visible_candidate","partly_visible_candidate","small_fragment_candidate","indeterminate"],"definition":"qualitative, not true hidden-area fraction"},
      {"key":"physical_occlusion_fraction","type":"number","definition":"unobservable by default from single RGB; no inferred amodal denominator"}
    ]},
    {"id":"local_context","sources":["T09","T10","T13"],"fields":[
      {"key":"nearby_pig_refs","type":"references","definition":"candidate neighboring instances with pixel relation, not identity proof"},
      {"key":"nearby_facility_refs","type":"references","definition":"facilities discovered from RGB only"},
      {"key":"support_surface_candidate","type":"object","definition":"visible/inferred floor or support surface tied to feet/torso evidence"},
      {"key":"floor_appearance_near_instance","type":"object","definition":"local floor visual type, unknown if surface not visible"},
      {"key":"head_near_feeder","type":"object","definition":"single-frame spatial relation, not confirmed feeding behavior"},
      {"key":"head_near_drinker","type":"object","definition":"single-frame spatial relation, not confirmed drinking"},
      {"key":"visible_facility_constraints","type":"object","definition":"bars near body and projected space, not metric enclosure dimensions"}
    ]},
    {"id":"instance_image_quality","sources":["T02","T03","T04","T07"],"fields":[
      {"key":"source_and_view_pixel_sizes","type":"object","unit":"pixels","definition":"actual source crop and actual processor grid, no nominal-only size"},
      {"key":"ROI_brightness","type":"object","unit":"declared_image_RGB_or_luma_units","definition":"ROI descriptor; whole box is not pure pig skin"},
      {"key":"ROI_contrast","type":"object","definition":"operator and ROI recorded, no physical light parameter"},
      {"key":"ROI_edge_clarity","type":"object","definition":"image descriptor with resolution and operator version"},
      {"key":"blur_candidate","type":"object","definition":"visible blur candidate; cause and motion speed unknown"},
      {"key":"noise_or_compression_candidate","type":"object","definition":"image artifact candidate; no guessed camera noise model"},
      {"key":"shadow_or_overexposure","type":"regions","definition":"evidence regions, not illumination calibration"},
      {"key":"appearance_modality","type":"enum","values":["color","near_monochrome","indeterminate"],"definition":"image appearance, not proof of IR sensor"},
      {"key":"evidence_readability","type":"object","definition":"task-specific unresolved details and additional-view obligations"}
    ]},
    {"id":"unidentifiable_physics","sources":["T09","T11","T12"],"fields":[
      {"key":"metric_body_dimensions","type":"object","definition":"unobservable by default in RGB-only policy without independent calibration"},
      {"key":"body_weight_or_age","type":"object","definition":"unobservable by default; apparent size is not age/weight"},
      {"key":"breed_or_sex","type":"object","definition":"no forced category; preserve visible anatomical evidence separately"},
      {"key":"hidden_3D_joints","type":"object","definition":"unobservable; symmetry prior is not observed ground truth"},
      {"key":"world_orientation_or_camera_metric_pose","type":"object","definition":"unobservable by default; author label metadata forbidden"},
      {"key":"cross_frame_animal_identity","type":"object","definition":"outside single-frame scope"}
    ]}
  ],
